<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Habits -->
    <LinearLayout
        android:id="@+id/nav_habits"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:clickable="true"
        android:focusable="true"
        android:background="?attr/selectableItemBackgroundBorderless">

        <ImageView
            android:id="@+id/icon_habits"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="Habits"
            android:src="@drawable/ic_habits_home" />

        <TextView
            android:id="@+id/label_habits"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Habits"
            android:textColor="@color/nav_icon_default"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Stats -->
    <LinearLayout
        android:id="@+id/nav_stats"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:clickable="true"
        android:focusable="true"
        android:background="?attr/selectableItemBackgroundBorderless">

        <ImageView
            android:id="@+id/icon_stats"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="Stats"
            android:src="@drawable/ic_graph_bar_light" />

        <TextView
            android:id="@+id/label_stats"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Stats"
            android:textColor="@color/nav_icon_default"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Center Add button -->
    <LinearLayout
        android:id="@+id/nav_add"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center"
        android:clickable="true"
        android:focusable="true"
        android:background="?attr/selectableItemBackgroundBorderless">

        <ImageView
            android:id="@+id/icon_add"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_circle_add"
            android:contentDescription="Add"
            android:padding="8dp"
            android:src="@drawable/ic_add_light" />
    </LinearLayout>

    <!-- Journal -->
    <LinearLayout
        android:id="@+id/nav_journal"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:clickable="true"
        android:focusable="true"
        android:background="?attr/selectableItemBackgroundBorderless">

        <ImageView
            android:id="@+id/icon_journal"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="Journal"
            android:src="@drawable/ic_journal_light" />

        <TextView
            android:id="@+id/label_journal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Journal"
            android:textColor="@color/nav_icon_default"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Settings -->
    <LinearLayout
        android:id="@+id/nav_settings"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:clickable="true"
        android:focusable="true"
        android:background="?attr/selectableItemBackgroundBorderless">

        <ImageView
            android:id="@+id/icon_settings"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="Settings"
            android:src="@drawable/ic_setting_light" />

        <TextView
            android:id="@+id/label_settings"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Settings"
            android:textColor="@color/nav_icon_default"
            android:textSize="12sp" />
    </LinearLayout>

</merge>