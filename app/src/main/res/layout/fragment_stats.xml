<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvStatsTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="STATISTICS"
            android:textAlignment="center"
            android:textStyle="bold"
            android:textSize="26sp"
            android:layout_marginTop="16dp" />

        <TextView
            android:id="@+id/tvStatsSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="22 AUG 2026"
            android:textAlignment="center"
            android:textColor="@color/stats_text_muted"
            android:textSize="13sp"
            android:layout_marginBottom="16dp" />

        <LinearLayout
            android:id="@+id/periodToggleGroup"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:orientation="horizontal"
            android:background="@color/stats_screen_bg"
            android:layout_marginHorizontal="16dp">

            <TextView
                android:id="@+id/tabWeek"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="WEEK"
                android:gravity="center"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:background="@drawable/bg_toggle_selected"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/tabMonth"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="MONTH"
                android:gravity="center"
                android:textColor="@color/black"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/tabYear"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="YEAR"
                android:gravity="center"
                android:textColor="@color/black"
                android:clickable="true"
                android:focusable="true" />

        </LinearLayout>

        <include
            android:id="@+id/viewStatsWeek"
            layout="@layout/view_stats_week" />

        <include
            android:id="@+id/viewStatsMonth"
            layout="@layout/view_stats_month"
            android:visibility="gone" />

        <include
            android:id="@+id/viewStatsYear"
            layout="@layout/view_stats_year"
            android:visibility="gone" />

    </LinearLayout>
</ScrollView>